# AGRI-SETU Environment Variables Configuration
# GEMINI_API_KEY: Required for Gemini AI API calls (Vision leaf analysis, Assistant Chatbot)
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Server Port
PORT=3000
NODE_ENV="development"

# JWT Authentication Secret
JWT_SECRET="agri_setu_production_jwt_secret_key_hackfest_3_2025"

# Relational Database URL (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrisetu"

# External API Keys (Optional fallbacks provided if omitted)
OPENWEATHER_API_KEY=""
AGMARKNET_API_KEY=""
